<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ArokoDB"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="On-device vector search powered by Rust"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:text="Starting..."
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="INDEX"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_dimension"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vector dimension"
            android:inputType="number"
            android:text="3" />

        <Button
            android:id="@+id/btn_init"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create / reset index" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ADD A VECTOR"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vector ID (non-negative)"
            android:inputType="number"
            android:text="1" />

        <EditText
            android:id="@+id/input_vector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Values, separated by commas (e.g. 0.1, 0.2, 0.3)"
            android:inputType="text|textNoSuggestions" />

        <Button
            android:id="@+id/btn_store"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add vector" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SEARCH"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_query"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Query vector, comma-separated"
            android:inputType="text|textNoSuggestions" />

        <Spinner
            android:id="@+id/input_metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/input_top_k"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Top K"
            android:inputType="number"
            android:text="5" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search" />

        <TextView
            android:id="@+id/txt_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingBottom="20dp"
            android:text="No vectors yet."
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>